# syntax=docker/dockerfile:1.7

FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN groupadd --system bouncer && useradd --system --gid bouncer --home /app bouncer
WORKDIR /app
COPY --chown=bouncer:bouncer benchmarking/__init__.py benchmarking/mock_nim.py benchmarking/mock_nim_cli.py ./benchmarking/
COPY --chown=bouncer:bouncer benchmarks/scenarios.json ./benchmarks/scenarios.json
USER bouncer
EXPOSE 8001
HEALTHCHECK --interval=2s --timeout=2s --retries=15 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/v1/health/ready', timeout=1)"]
ENTRYPOINT ["python", "-m", "benchmarking.mock_nim_cli"]
CMD ["--host", "0.0.0.0", "--port", "8001"]
