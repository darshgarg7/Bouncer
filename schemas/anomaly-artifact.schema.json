{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bouncer.dev/schemas/anomaly-artifact.schema.json",
  "title": "Bouncer portable Isolation Forest artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "feature_schema_version",
    "feature_names",
    "created_at",
    "provenance",
    "threshold",
    "active_eligible",
    "sample_size",
    "trees"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "feature_schema_version": {"const": "0.1.0"},
    "feature_names": {
      "const": [
        "rejection_rate",
        "retry_rate",
        "no_progress_streak",
        "tool_switch_rate",
        "latency_delta_ms",
        "transition_nll"
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "active_eligible": {"type": "boolean"},
    "sample_size": {"type": "integer", "minimum": 2, "maximum": 1000000},
    "trees": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"active_eligible": {"const": true}},
        "required": ["active_eligible"]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": ["validation"],
            "properties": {
              "validation": {
                "properties": {
                  "rows": {"minimum": 20},
                  "normal_rows": {"minimum": 5},
                  "anomaly_rows": {"minimum": 5},
                  "true_positive_rate": {"minimum": 0.8},
                  "false_positive_rate": {"maximum": 0.05}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "dataset_sha256", "training_rows", "seed"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "training_rows": {"type": "integer", "minimum": 2},
        "seed": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset_sha256",
            "rows",
            "normal_rows",
            "anomaly_rows",
            "true_positive_rate",
            "false_positive_rate"
          ],
          "properties": {
            "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "rows": {"type": "integer", "minimum": 2},
            "normal_rows": {"type": "integer", "minimum": 1},
            "anomaly_rows": {"type": "integer", "minimum": 1},
            "true_positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "false_positive_rate": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "feature", "split", "left", "right"],
          "properties": {
            "size": {"type": "integer", "minimum": 1},
            "feature": {"type": "null"},
            "split": {"type": "null"},
            "left": {"type": "null"},
            "right": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "feature", "split", "left", "right"],
          "properties": {
            "size": {"type": "integer", "minimum": 2},
            "feature": {"type": "integer", "minimum": 0, "maximum": 5},
            "split": {"type": "number"},
            "left": {"$ref": "#/$defs/node"},
            "right": {"$ref": "#/$defs/node"}
          }
        }
      ]
    }
  }
}
