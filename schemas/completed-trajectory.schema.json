{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bouncer.dev/schemas/completed-trajectory.schema.json",
  "title": "Bouncer completed learning trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_id", "passed", "terminal", "censored", "transitions"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "terminal": {"type": "boolean"},
    "censored": {"type": "boolean"},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "outcome", "reward_to_go"],
        "properties": {
          "decision": {"$ref": "routing-decision.schema.json"},
          "outcome": {"$ref": "measured-action-outcome.schema.json"},
          "reward_to_go": {
            "type": "object",
            "additionalProperties": false,
            "required": ["progress", "success", "latency_ms", "cost_units", "adverse_risk"],
            "properties": {
              "progress": {"type": "number"},
              "success": {"type": "number"},
              "latency_ms": {"type": "number"},
              "cost_units": {"type": "number"},
              "adverse_risk": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
