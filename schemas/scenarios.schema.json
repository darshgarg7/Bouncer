{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bouncer.dev/schemas/scenarios.schema.json",
  "title": "Bouncer deterministic simulator scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "scenarios": {
      "type": "object",
      "minProperties": 10,
      "maxProperties": 10,
      "propertyNames": {"pattern": "^task-[0-9]{3}$"},
      "additionalProperties": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_class", "tool", "target", "arguments", "declared_dependencies"],
      "properties": {
        "operation_class": {
          "enum": [
            "filesystem.read",
            "filesystem.write",
            "filesystem.delete",
            "state.validate",
            "state.backup",
            "command.run",
            "service.deploy",
            "task.complete"
          ]
        },
        "tool": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"},
        "declared_dependencies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
