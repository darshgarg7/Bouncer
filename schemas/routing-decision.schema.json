{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bouncer.dev/schemas/routing-decision.schema.json",
  "title": "Bouncer routing decision observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "decision_id",
    "turn",
    "state",
    "candidates",
    "selected_candidate_id",
    "behavior_probability",
    "versions"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "turn": {"type": "integer", "minimum": 0},
    "state": {"$ref": "#/$defs/state"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "selected_candidate_id": {"type": "string", "minLength": 1},
    "behavior_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "versions": {"$ref": "#/$defs/versions"},
    "learning": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/learning"}
      ]
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_sha256",
        "benchmark_step",
        "mutation_count",
        "completed_operations",
        "file_count",
        "constraint_feedback_count"
      ],
      "properties": {
        "state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "benchmark_step": {"type": "integer", "minimum": 0},
        "mutation_count": {"type": "integer", "minimum": 0},
        "completed_operations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "file_count": {"type": "integer", "minimum": 0},
        "constraint_feedback_count": {"type": "integer", "minimum": 0}
      }
    },
    "objectives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "cost_units", "safety_risk"],
      "properties": {
        "latency_ms": {"type": "number", "minimum": 0},
        "cost_units": {"type": "number", "minimum": 0},
        "safety_risk": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "operation_class", "tool", "target_category", "routing_objectives"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "operation_class": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "target_category": {"type": "string", "minLength": 1},
        "routing_objectives": {"$ref": "#/$defs/objectives"},
        "features": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_schema", "policy_sha256", "calibration_sha256"],
      "properties": {
        "feature_schema": {"type": "string", "minLength": 1},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "calibration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "learning_artifact_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "uncertainty", "conservative"],
      "properties": {
        "mean": {"type": "number"},
        "uncertainty": {"type": "number", "minimum": 0},
        "conservative": {"type": "number"}
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "artifact_id", "artifact_sha256", "frontier_candidate_ids", "predictions"],
      "properties": {
        "mode": {"enum": ["shadow", "active"]},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "frontier_candidate_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "predictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "progress", "success", "latency_ms", "cost_units", "adverse_risk"],
            "properties": {
              "candidate_id": {"type": "string", "minLength": 1},
              "progress": {"$ref": "#/$defs/estimate"},
              "success": {"$ref": "#/$defs/estimate"},
              "latency_ms": {"$ref": "#/$defs/estimate"},
              "cost_units": {"$ref": "#/$defs/estimate"},
              "adverse_risk": {"$ref": "#/$defs/estimate"}
            }
          }
        }
      }
    }
  }
}
