{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bouncer.dev/schemas/measured-action-outcome.schema.json",
  "title": "Bouncer measured action outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "decision_id",
    "turn",
    "candidate_id",
    "state_before_sha256",
    "state_after_sha256",
    "latency_ms",
    "cost_units",
    "cost_censored",
    "progress_before",
    "progress_after",
    "progress_delta",
    "adverse",
    "terminal",
    "censored"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "turn": {"type": "integer", "minimum": 0},
    "candidate_id": {"type": "string", "minLength": 1},
    "state_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "latency_ms": {"type": "number", "minimum": 0},
    "cost_units": {
      "oneOf": [
        {"type": "null"},
        {"type": "number", "minimum": 0}
      ]
    },
    "cost_censored": {"type": "boolean"},
    "progress_before": {"type": "number", "minimum": 0, "maximum": 1},
    "progress_after": {"type": "number", "minimum": 0, "maximum": 1},
    "progress_delta": {"type": "number", "minimum": -1, "maximum": 1},
    "adverse": {"type": "boolean"},
    "terminal": {"type": "boolean"},
    "censored": {"type": "boolean"},
    "censor_reason": {"type": ["string", "null"]}
  }
}
